APP_ENV=development
# Public URL of the web app (links in emails and the Google sign-in return go here), e.g. https://main.<id>.amplifyapp.com
APP_URL=http://localhost:5173
# DATABASE_URL=sqlite:////absolute/path/jalmarg.db (default: backend/data/jalmarg.db)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
# Long random string (openssl rand -hex 32) that signs private file links. Generated into data/ if empty.
AUTH_SECRET=

# ---------- Administrator (one account, created/updated at startup) ----------
ADMIN_EMAIL=
# E.164 format, e.g. +919876543210
ADMIN_PHONE=
# scrypt hash, never the password itself. Generate with:  python -m app.hash_password
ADMIN_PASSWORD_HASH=

# ---------- Email (verification and password reset) ----------
# console (links printed to the API log) | smtp
EMAIL_DELIVERY=console
SMTP_HOST=
# 587 with starttls, 465 with ssl
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender, e.g. JalMarg <no-reply@your-domain>. Defaults to SMTP_USERNAME.
SMTP_FROM=

# ---------- Google sign-in (optional; OAuth client type "Web application") ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client: <API base URL>/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------- Maps and weather ----------
# osm (default without a key: MapLibre + OpenFreeMap tiles, Nominatim/Photon, OSRM, Overpass) | google
MAP_PROVIDER=
# Contact address sent to OpenStreetMap services in the User-Agent, as their usage policy asks.
CONTACT_EMAIL=
# Google Maps Platform (Maps JS, Places, Geocoding, Roads, Routes, Weather). One key can serve all; restrict it in Google Cloud.
GOOGLE_MAPS_API_KEY=
# Browser key for the map (HTTP-referrer restricted). Defaults to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_BROWSER_KEY=
# Map ID for Advanced Markers (Google Cloud > Map Management).
GOOGLE_MAP_ID=
GOOGLE_WEATHER_API_KEY=
# google | open-meteo. Defaults to google when a key is set.
WEATHER_PROVIDER=

# ---------- Storage and photo check ----------
# local | s3 (private bucket S3_BUCKET in AWS_REGION; EC2 instance role gives access)
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
S3_BUCKET=
# none | bedrock: Claude on Amazon Bedrock checks each report photo for water (pip install -r requirements-aws.txt)
VISION_PROVIDER=none
VISION_MODEL=anthropic.claude-opus-5-5

MAX_GPS_ACCURACY_M=50
SAME_SEGMENT_M=150
POSSIBLE_DUPLICATE_M=500
INCIDENT_TTL_HOURS=6
