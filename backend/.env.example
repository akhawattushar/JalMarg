APP_ENV=development
# Google Maps Platform (Maps JS, Places, Geocoding, Roads, Routes, Weather). One key can serve all; restrict it in Google Cloud.
GOOGLE_MAPS_API_KEY=
# Browser key for the map (HTTP-referrer restricted). Defaults to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_BROWSER_KEY=
# Map ID for Advanced Markers (Google Cloud > Map Management).
GOOGLE_MAP_ID=
GOOGLE_WEATHER_API_KEY=
# google | osm (OpenStreetMap: Nominatim, OSRM, Overpass). Defaults to google when a key is set.
MAP_PROVIDER=
# google | open-meteo. Defaults to google when a key is set.
WEATHER_PROVIDER=
# local | s3 (private bucket S3_BUCKET in AWS_REGION; EC2 instance role gives access)
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
S3_BUCKET=
# none | bedrock: Claude on Amazon Bedrock checks each report photo for water (pip install -r requirements-aws.txt)
VISION_PROVIDER=none
VISION_MODEL=anthropic.claude-opus-5-5
# console | sns (Amazon SNS SMS; India needs DLT sender registration)
OTP_DELIVERY=console
# DATABASE_URL=sqlite:////absolute/path/jalmarg.db (default: backend/data/jalmarg.db)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
# Long random string that signs login tokens. Generated into data/ if empty.
AUTH_SECRET=
# Comma-separated phones that become admins on first sign-in, e.g. +919876543210
ADMIN_PHONES=
MAX_GPS_ACCURACY_M=50
SAME_SEGMENT_M=150
POSSIBLE_DUPLICATE_M=500
INCIDENT_TTL_HOURS=6
